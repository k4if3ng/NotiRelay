<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens for docs/design/ui-system.md. Literal spacing, font size, and
        corner radius values belong here and nowhere else; page XAML references these
        keys. Section numbers below match the specification.
    -->

    <!-- 2. Spacing — strict 4 px grid, six steps, no intermediate values. -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>

    <!-- Reusable component geometry. -->
    <x:Double x:Key="BrandMarkSize">20</x:Double>
    <x:Double x:Key="StandardIconSize">20</x:Double>
    <!-- Matches the glyph size NavigationViewItem renders its Icon at. -->
    <x:Double x:Key="NavigationGlyphSize">16</x:Double>
    <x:Double x:Key="TitleBarInteractiveSize">32</x:Double>
    <x:Double x:Key="CardTitleFontSize">16</x:Double>
    <Thickness x:Key="TitleBarBrandMargin">16,0,0,0</Thickness>
    <Thickness x:Key="TitleBarToggleMargin">8,0,0,0</Thickness>
    <Thickness x:Key="ZeroThickness">0</Thickness>
    <Thickness x:Key="ThinBorderThickness">1</Thickness>

    <!-- 3. Corner radius — container 8, control 4 (built-in ControlCornerRadius). -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">14</CornerRadius>

    <!-- 4. Density — two tiers. Configuration pages vs. list pages. -->
    <x:Double x:Key="RowHeightSetting">68</x:Double>
    <x:Double x:Key="RowHeightList">60</x:Double>

    <!-- 5. Card and row geometry. -->
    <Thickness x:Key="CardHeaderPadding">24,24,24,24</Thickness>
    <Thickness x:Key="CardCommandRowPadding">24,12,24,12</Thickness>
    <Thickness x:Key="CardRowPadding">24,12,24,12</Thickness>
    <Thickness x:Key="CardListRowPadding">24,8,24,8</Thickness>
    <Thickness x:Key="CardContentPadding">24,16,24,16</Thickness>
    <Thickness x:Key="CardFormRowPadding">24,16,24,16</Thickness>
    <Thickness x:Key="CardActionFooterPadding">24,16,24,16</Thickness>
    <Thickness x:Key="ClearActionMargin">8,0,0,0</Thickness>
    <Thickness x:Key="KeywordChipPadding">10,0,2,0</Thickness>
    <Thickness x:Key="RowDividerThickness">0,0,0,1</Thickness>
    <GridLength x:Key="CardIconColumnWidth">32</GridLength>
    <x:Double x:Key="KeywordRemoveButtonSize">24</x:Double>
    <x:Double x:Key="KeywordRemoveIconSize">8</x:Double>
    <x:Double x:Key="KeywordChipMinHeight">28</x:Double>
    <x:Double x:Key="KeywordChipMaxWidth">240</x:Double>
    <x:Double x:Key="KeywordChipTextMaxWidth">196</x:Double>
    <x:Double x:Key="ActionStatusSlotHeight">40</x:Double>
    <x:Double x:Key="InlineStatusSlotHeight">20</x:Double>
    <x:Double x:Key="ActionButtonHeight">32</x:Double>
    <x:Double x:Key="ActionButtonMinWidth">96</x:Double>
    <x:Double x:Key="ListViewportMaxHeight">480</x:Double>
    <x:Double x:Key="SettingsComboBoxWidth">200</x:Double>
    <x:Double x:Key="SettingsComboBoxCompactWidth">176</x:Double>
    <x:Double x:Key="SettingsButtonWidth">160</x:Double>
    <x:Double x:Key="SettingsButtonCompactWidth">160</x:Double>
    <x:Double x:Key="SettingsRowIconSize">16</x:Double>
    <GridLength x:Key="DestinationLabelColumnWidth">220</GridLength>
    <GridLength x:Key="DestinationLabelColumnCompactWidth">140</GridLength>
    <x:Double x:Key="DestinationInputMinWidth">0</x:Double>
    <x:Double x:Key="DestinationFormMaxWidth">960</x:Double>
    <x:Double x:Key="DestinationSecretButtonSize">32</x:Double>
    <Thickness x:Key="DestinationSecretEditorPadding">12,0,40,0</Thickness>
    <x:Double x:Key="DestinationActionButtonMinWidth">0</x:Double>
    <x:Double x:Key="DestinationActionGroupWidth">408</x:Double>
    <x:Double x:Key="EmptyStateViewportMinHeight">180</x:Double>
    <Thickness x:Key="CommandButtonPadding">8,4,8,4</Thickness>
    <Thickness x:Key="DestinationActionButtonPadding">8,0,8,0</Thickness>

    <!-- 9. Adaptive — every trigger keys off content width, never window width. -->
    <x:Double x:Key="ContentBreakpointStandard">760</x:Double>
    <x:Double x:Key="ContentBreakpointWide">1040</x:Double>
    <x:Double x:Key="RowReflowBreakpoint">720</x:Double>
    <x:Double x:Key="DestinationCompactBreakpoint">900</x:Double>
    <x:Double x:Key="MaxContentWidth">1200</x:Double>
    <Thickness x:Key="PagePaddingCompact">24,24,24,32</Thickness>
    <Thickness x:Key="PagePaddingStandard">40,24,40,32</Thickness>
    <Thickness x:Key="PagePaddingWide">56,24,56,32</Thickness>
    <Thickness x:Key="PageScrollbarSafeInset">0,0,12,0</Thickness>

    <!-- 10. Shell. -->
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <GridLength x:Key="TitleBarRowHeight">48</GridLength>
    <x:Double x:Key="NavPaneExpandedWidth">232</x:Double>
    <x:Double x:Key="NavPaneCompactWidth">48</x:Double>
    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">44</x:Double>

    <!-- Toolkit controls consume these well-known resource names. -->
    <x:Double x:Key="SettingsCardWrapThreshold">720</x:Double>

    <!-- 1. Type ramp — six levels, all on the WinUI ramp. -->
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RowTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DescriptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ErrorDescriptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- 5. The group card is the only grouping mechanism. Never group with spacing. -->
    <Style x:Key="GroupCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="CardDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollMode" Value="Auto" />
    </Style>

    <Style x:Key="PageContentStackStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Spacing" Value="{StaticResource SpacingXL}" />
    </Style>

    <Style x:Key="CardStackStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Spacing" Value="{StaticResource SpacingL}" />
    </Style>

    <Style x:Key="CardContentStackStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Spacing" Value="{StaticResource SpacingM}" />
    </Style>

    <!--
        7. Icon-only buttons. Both clear the default Button chrome so the glyph is the
        only mark at rest. PointerOver, Pressed, and Disabled still come from the
        native Button template, which sets its own backgrounds in those visual states.
    -->
    <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource ZeroThickness}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarIconButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource CommandButtonPadding}" />
    </Style>

    <Style x:Key="ChipRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource ZeroThickness}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ChipCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ActionButtonMinWidth}" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ActionButtonHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ActionButtonMinWidth}" />
    </Style>

    <Style x:Key="DestinationActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource DestinationActionButtonMinWidth}" />
        <Setter Property="Padding" Value="{StaticResource DestinationActionButtonPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DestinationPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource DestinationActionButtonMinWidth}" />
        <Setter Property="Padding" Value="{StaticResource DestinationActionButtonPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SettingsButtonWidth}" />
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="{StaticResource SettingsComboBoxWidth}" />
    </Style>

    <Style x:Key="SettingsRowIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource SettingsRowIconSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
