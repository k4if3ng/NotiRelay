<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NotiRelay.Views.DestinationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiRelay.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <controls:PageLayout MaxContentWidth="{StaticResource MaxContentWidth}">
        <controls:PageLayout.PageContent>
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <controls:PageHeader x:Uid="DestinationsHeader" />
                <StackPanel Style="{StaticResource CardStackStyle}">
                    <toolkit:SettingsExpander x:Name="BarkGroup" x:Uid="DestinationBarkGroup">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource StandardIconSize}" Glyph="&#xE774;" /></toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingM}">
                                <TextBlock x:Name="BarkHeaderStatusText" VerticalAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                <ToggleSwitch x:Name="BarkEnabledToggle" MinWidth="0" AutomationProperties.Name="{x:Bind BarkEnabledAutomationName}" OffContent="" OnContent="" Toggled="BarkEnabledToggle_Toggled" />
                            </StackPanel>
                        </toolkit:SettingsExpander.Content>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentAlignment="Vertical" Padding="{StaticResource ZeroThickness}">
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="BarkServerUrlRow" MaxWidth="{StaticResource DestinationFormMaxWidth}" MinHeight="{StaticResource RowHeightSetting}" HorizontalAlignment="Stretch" Padding="{StaticResource CardFormRowPadding}" ColumnSpacing="{StaticResource SpacingL}" SizeChanged="DestinationFieldRow_SizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource DestinationLabelColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                        <TextBlock Text="{x:Bind BarkServerUrlTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind BarkServerUrlDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="BarkServerUrlTextBox" Grid.Column="1" MinWidth="{StaticResource DestinationInputMinWidth}" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextChanged="Editor_TextChanged" />
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />
                                <Grid x:Name="BarkDeviceKeyRow" Grid.Row="2" MaxWidth="{StaticResource DestinationFormMaxWidth}" MinHeight="{StaticResource RowHeightSetting}" HorizontalAlignment="Stretch" Padding="{StaticResource CardFormRowPadding}" ColumnSpacing="{StaticResource SpacingL}" SizeChanged="DestinationFieldRow_SizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource DestinationLabelColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                        <TextBlock Text="{x:Bind BarkDeviceKeyTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind BarkDeviceKeyDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" MinWidth="{StaticResource DestinationInputMinWidth}" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <PasswordBox x:Name="BarkDeviceKeyPasswordBox" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" Padding="{StaticResource DestinationSecretEditorPadding}" PasswordChanged="Editor_PasswordChanged" PasswordRevealMode="Hidden" />
                                        <Button x:Name="BarkSecretRevealButton" Width="{StaticResource DestinationSecretButtonSize}" Height="{StaticResource DestinationSecretButtonSize}" HorizontalAlignment="Right" Visibility="Collapsed" Click="SecretRevealButton_Click" Style="{StaticResource TitleBarIconButtonStyle}">
                                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE890;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <Border Grid.Row="3" Style="{StaticResource CardDividerStyle}" />
                                <Grid x:Name="BarkActionFooter" Grid.Row="4" MaxWidth="{StaticResource DestinationFormMaxWidth}" HorizontalAlignment="Stretch" Padding="{StaticResource CardActionFooterPadding}" ColumnSpacing="{StaticResource SpacingL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BarkFeedbackText" MinWidth="0" Height="{StaticResource ActionStatusSlotHeight}" MaxLines="1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <Grid x:Name="BarkActionButtons" Grid.Column="1" Width="{StaticResource DestinationActionGroupWidth}" HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="{StaticResource SpacingS}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button x:Name="BarkSaveButton" x:Uid="DestinationSaveAction" Click="BarkSaveButton_Click" Style="{StaticResource DestinationPrimaryActionButtonStyle}" />
                                        <Button x:Name="BarkCancelButton" x:Uid="DestinationCancelAction" Grid.Column="1" Click="BarkCancelButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                        <Button x:Name="BarkTestButton" x:Uid="DestinationTestAction" Grid.Column="2" Click="BarkTestButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                        <Button x:Name="BarkClearButton" x:Uid="DestinationClearAction" Grid.Column="3" Click="BarkClearButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                    </Grid>
                                </Grid>
                                </Grid>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander x:Name="WebhookGroup" x:Uid="DestinationWebhookGroup">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource StandardIconSize}" Glyph="&#xE71B;" /></toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingM}">
                                <TextBlock x:Name="WebhookHeaderStatusText" VerticalAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                <ToggleSwitch x:Name="WebhookEnabledToggle" MinWidth="0" AutomationProperties.Name="{x:Bind WebhookEnabledAutomationName}" OffContent="" OnContent="" Toggled="WebhookEnabledToggle_Toggled" />
                            </StackPanel>
                        </toolkit:SettingsExpander.Content>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentAlignment="Vertical" Padding="{StaticResource ZeroThickness}">
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="WebhookEndpointRow" MaxWidth="{StaticResource DestinationFormMaxWidth}" MinHeight="{StaticResource RowHeightSetting}" HorizontalAlignment="Stretch" Padding="{StaticResource CardFormRowPadding}" ColumnSpacing="{StaticResource SpacingL}" SizeChanged="DestinationFieldRow_SizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource DestinationLabelColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                        <TextBlock Text="{x:Bind WebhookEndpointTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind WebhookEndpointDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="WebhookEndpointTextBox" Grid.Column="1" MinWidth="{StaticResource DestinationInputMinWidth}" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextChanged="Editor_TextChanged" />
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />
                                <Grid x:Name="WebhookTokenRow" Grid.Row="2" MaxWidth="{StaticResource DestinationFormMaxWidth}" MinHeight="{StaticResource RowHeightSetting}" HorizontalAlignment="Stretch" Padding="{StaticResource CardFormRowPadding}" ColumnSpacing="{StaticResource SpacingL}" SizeChanged="DestinationFieldRow_SizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource DestinationLabelColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                        <TextBlock Text="{x:Bind WebhookTokenTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind WebhookTokenDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" MinWidth="{StaticResource DestinationInputMinWidth}" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <PasswordBox x:Name="WebhookTokenPasswordBox" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" Padding="{StaticResource DestinationSecretEditorPadding}" PasswordChanged="Editor_PasswordChanged" PasswordRevealMode="Hidden" />
                                        <Button x:Name="WebhookSecretRevealButton" Width="{StaticResource DestinationSecretButtonSize}" Height="{StaticResource DestinationSecretButtonSize}" HorizontalAlignment="Right" Visibility="Collapsed" Click="SecretRevealButton_Click" Style="{StaticResource TitleBarIconButtonStyle}">
                                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE890;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <Border Grid.Row="3" Style="{StaticResource CardDividerStyle}" />
                                <Grid x:Name="WebhookActionFooter" Grid.Row="4" MaxWidth="{StaticResource DestinationFormMaxWidth}" HorizontalAlignment="Stretch" Padding="{StaticResource CardActionFooterPadding}" ColumnSpacing="{StaticResource SpacingL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WebhookFeedbackText" MinWidth="0" Height="{StaticResource ActionStatusSlotHeight}" MaxLines="1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <Grid x:Name="WebhookActionButtons" Grid.Column="1" Width="{StaticResource DestinationActionGroupWidth}" HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="{StaticResource SpacingS}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button x:Name="WebhookSaveButton" x:Uid="DestinationSaveAction" Click="WebhookSaveButton_Click" Style="{StaticResource DestinationPrimaryActionButtonStyle}" />
                                        <Button x:Name="WebhookCancelButton" x:Uid="DestinationCancelAction" Grid.Column="1" Click="WebhookCancelButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                        <Button x:Name="WebhookTestButton" x:Uid="DestinationTestAction" Grid.Column="2" Click="WebhookTestButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                        <Button x:Name="WebhookClearButton" x:Uid="DestinationClearAction" Grid.Column="3" Click="WebhookClearButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                    </Grid>
                                </Grid>
                                </Grid>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander x:Name="TelegramGroup" x:Uid="DestinationTelegramGroup">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource StandardIconSize}" Glyph="&#xE724;" /></toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Content>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingM}">
                                <TextBlock x:Name="TelegramHeaderStatusText" VerticalAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                <ToggleSwitch x:Name="TelegramEnabledToggle" MinWidth="0" AutomationProperties.Name="{x:Bind TelegramEnabledAutomationName}" OffContent="" OnContent="" Toggled="TelegramEnabledToggle_Toggled" />
                            </StackPanel>
                        </toolkit:SettingsExpander.Content>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentAlignment="Vertical" Padding="{StaticResource ZeroThickness}">
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="TelegramTokenRow" MaxWidth="{StaticResource DestinationFormMaxWidth}" MinHeight="{StaticResource RowHeightSetting}" HorizontalAlignment="Stretch" Padding="{StaticResource CardFormRowPadding}" ColumnSpacing="{StaticResource SpacingL}" SizeChanged="DestinationFieldRow_SizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource DestinationLabelColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                        <TextBlock Text="{x:Bind TelegramTokenTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind TelegramTokenDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" MinWidth="{StaticResource DestinationInputMinWidth}" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <PasswordBox x:Name="TelegramTokenPasswordBox" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" Padding="{StaticResource DestinationSecretEditorPadding}" PasswordChanged="Editor_PasswordChanged" PasswordRevealMode="Hidden" />
                                        <Button x:Name="TelegramSecretRevealButton" Width="{StaticResource DestinationSecretButtonSize}" Height="{StaticResource DestinationSecretButtonSize}" HorizontalAlignment="Right" Visibility="Collapsed" Click="SecretRevealButton_Click" Style="{StaticResource TitleBarIconButtonStyle}">
                                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE890;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />
                                <Grid x:Name="TelegramChatIdRow" Grid.Row="2" MaxWidth="{StaticResource DestinationFormMaxWidth}" MinHeight="{StaticResource RowHeightSetting}" HorizontalAlignment="Stretch" Padding="{StaticResource CardFormRowPadding}" ColumnSpacing="{StaticResource SpacingL}" SizeChanged="DestinationFieldRow_SizeChanged">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource DestinationLabelColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                        <TextBlock Text="{x:Bind TelegramChatIdTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind TelegramChatIdDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBox x:Name="TelegramChatIdTextBox" Grid.Column="1" MinWidth="{StaticResource DestinationInputMinWidth}" Height="{StaticResource ActionButtonHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextChanged="Editor_TextChanged" />
                                </Grid>
                                <Border Grid.Row="3" Style="{StaticResource CardDividerStyle}" />
                                <Grid x:Name="TelegramActionFooter" Grid.Row="4" MaxWidth="{StaticResource DestinationFormMaxWidth}" HorizontalAlignment="Stretch" Padding="{StaticResource CardActionFooterPadding}" ColumnSpacing="{StaticResource SpacingL}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TelegramFeedbackText" MinWidth="0" Height="{StaticResource ActionStatusSlotHeight}" MaxLines="1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <Grid x:Name="TelegramActionButtons" Grid.Column="1" Width="{StaticResource DestinationActionGroupWidth}" HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="{StaticResource SpacingS}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button x:Name="TelegramSaveButton" x:Uid="DestinationSaveAction" Click="TelegramSaveButton_Click" Style="{StaticResource DestinationPrimaryActionButtonStyle}" />
                                        <Button x:Name="TelegramCancelButton" x:Uid="DestinationCancelAction" Grid.Column="1" Click="TelegramCancelButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                        <Button x:Name="TelegramTestButton" x:Uid="DestinationTestAction" Grid.Column="2" Click="TelegramTestButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                        <Button x:Name="TelegramClearButton" x:Uid="DestinationClearAction" Grid.Column="3" Click="TelegramClearButton_Click" Style="{StaticResource DestinationActionButtonStyle}" />
                                    </Grid>
                                </Grid>
                                </Grid>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                </StackPanel>
            </StackPanel>
        </controls:PageLayout.PageContent>
    </controls:PageLayout>
</Page>
