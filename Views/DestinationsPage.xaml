<Page x:Class="NotiRelay.Views.DestinationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100">
        <StackPanel Spacing="4"><TextBlock x:Uid="DestinationsTitle" FontSize="28" FontWeight="SemiBold" /><TextBlock x:Uid="DestinationsSubtitle" Opacity="0.7" /></StackPanel>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="Bark" HorizontalContentAlignment="Left" Padding="20" Click="BarkCard_Click" />
            <Button x:Uid="GenericWebhookCard" Grid.Column="1" HorizontalContentAlignment="Left" Padding="20" Click="WebhookCard_Click" />
            <Button Grid.Column="2" Content="Telegram" HorizontalContentAlignment="Left" Padding="20" Click="TelegramCard_Click" />
        </Grid>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
            <Grid>
                <StackPanel x:Name="BarkEditor" Spacing="10"><TextBlock x:Uid="BarkProfileTitle" FontSize="20" FontWeight="SemiBold" /><TextBox x:Uid="BarkServerUrl" x:Name="BarkServerUrlTextBox" /><PasswordBox x:Uid="BarkDeviceKey" x:Name="BarkDeviceKeyPasswordBox" PasswordRevealMode="Peek" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="SaveProfile" Click="SaveBarkButton_Click" /><Button x:Uid="SendTest" Click="TestBarkButton_Click" /><Button x:Uid="ClearProfile" Click="ClearBarkButton_Click" /></StackPanel></StackPanel>
                <StackPanel x:Name="WebhookEditor" Visibility="Collapsed" Spacing="10"><TextBlock x:Uid="WebhookProfileTitle" FontSize="20" FontWeight="SemiBold" /><TextBox x:Uid="WebhookEndpoint" x:Name="WebhookEndpointTextBox" /><PasswordBox x:Uid="WebhookToken" x:Name="WebhookTokenPasswordBox" PasswordRevealMode="Peek" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="SaveProfile" Click="SaveWebhookButton_Click" /><Button x:Uid="SendTest" Click="TestWebhookButton_Click" /><Button x:Uid="ClearProfile" Click="ClearWebhookButton_Click" /></StackPanel></StackPanel>
                <StackPanel x:Name="TelegramEditor" Visibility="Collapsed" Spacing="10"><TextBlock x:Uid="TelegramProfileTitle" FontSize="20" FontWeight="SemiBold" /><PasswordBox x:Uid="TelegramBotToken" x:Name="TelegramTokenPasswordBox" PasswordRevealMode="Peek" /><TextBox x:Uid="TelegramChatId" x:Name="TelegramChatIdTextBox" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="SaveProfile" Click="SaveTelegramButton_Click" /><Button x:Uid="SendTest" Click="TestTelegramButton_Click" /><Button x:Uid="ClearProfile" Click="ClearTelegramButton_Click" /></StackPanel></StackPanel>
            </Grid>
        </Border>
        <InfoBar x:Name="ResultInfoBar" IsOpen="False" IsClosable="True" />
    </StackPanel></ScrollViewer>
</Page>
