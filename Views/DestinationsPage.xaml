<Page x:Class="NotiRelay.Views.DestinationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100">
        <StackPanel Spacing="4"><TextBlock Text="Destinations" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Configure one profile for each supported destination." Opacity="0.7" /></StackPanel>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="Bark" HorizontalContentAlignment="Left" Padding="20" Click="BarkCard_Click" />
            <Button Grid.Column="1" Content="Generic Webhook" HorizontalContentAlignment="Left" Padding="20" Click="WebhookCard_Click" />
            <Button Grid.Column="2" Content="Telegram" HorizontalContentAlignment="Left" Padding="20" Click="TelegramCard_Click" />
        </Grid>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
            <Grid>
                <StackPanel x:Name="BarkEditor" Spacing="10"><TextBlock Text="Bark profile" FontSize="20" FontWeight="SemiBold" /><TextBox x:Name="BarkServerUrlTextBox" Header="Server URL" /><PasswordBox x:Name="BarkDeviceKeyPasswordBox" Header="Device key" PasswordRevealMode="Peek" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save" Click="SaveBarkButton_Click" /><Button Content="Send test" Click="TestBarkButton_Click" /><Button Content="Clear" Click="ClearBarkButton_Click" /></StackPanel></StackPanel>
                <StackPanel x:Name="WebhookEditor" Visibility="Collapsed" Spacing="10"><TextBlock Text="Generic Webhook profile" FontSize="20" FontWeight="SemiBold" /><TextBox x:Name="WebhookEndpointTextBox" Header="Endpoint URL" /><PasswordBox x:Name="WebhookTokenPasswordBox" Header="Bearer token (optional)" PasswordRevealMode="Peek" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save" Click="SaveWebhookButton_Click" /><Button Content="Send test" Click="TestWebhookButton_Click" /><Button Content="Clear" Click="ClearWebhookButton_Click" /></StackPanel></StackPanel>
                <StackPanel x:Name="TelegramEditor" Visibility="Collapsed" Spacing="10"><TextBlock Text="Telegram profile" FontSize="20" FontWeight="SemiBold" /><PasswordBox x:Name="TelegramTokenPasswordBox" Header="Bot token" PasswordRevealMode="Peek" /><TextBox x:Name="TelegramChatIdTextBox" Header="Chat ID" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save" Click="SaveTelegramButton_Click" /><Button Content="Send test" Click="TestTelegramButton_Click" /><Button Content="Clear" Click="ClearTelegramButton_Click" /></StackPanel></StackPanel>
            </Grid>
        </Border>
        <InfoBar x:Name="ResultInfoBar" IsOpen="False" IsClosable="True" />
    </StackPanel></ScrollViewer>
</Page>
