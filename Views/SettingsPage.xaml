<Page x:Class="NotiRelay.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="900">
        <TextBlock x:Uid="SettingsTitle" FontSize="28" FontWeight="SemiBold" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="SettingsSystem" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="AccessStatusText" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="RequestNotificationAccess" Click="RequestAccessButton_Click" /><Button x:Uid="Refresh" Click="RefreshButton_Click" /></StackPanel><ToggleSwitch x:Uid="StartupAtSignIn" x:Name="StartupToggle" Toggled="StartupToggle_Toggled" /></StackPanel></Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="SettingsLanguage" FontSize="20" FontWeight="SemiBold" /><ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged"><ComboBoxItem x:Uid="LanguageSystem" Tag="" /><ComboBoxItem x:Uid="LanguageEnglish" Tag="en-US" /><ComboBoxItem x:Uid="LanguageChinese" Tag="zh-CN" /></ComboBox></StackPanel></Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="SettingsPrivacy" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Uid="SettingsPrivacyDescription" TextWrapping="Wrap" /><Button x:Uid="ClearDeliveryMetadata" HorizontalAlignment="Left" Click="ClearMetadataButton_Click" /></StackPanel></Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel><TextBlock x:Uid="SettingsAbout" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="NotiRelay 1.0.0" /><TextBlock x:Uid="SettingsPlatform" Opacity="0.7" /></StackPanel></Border>
        <InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" />
    </StackPanel></ScrollViewer>
</Page>
