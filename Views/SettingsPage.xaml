<Page x:Class="NotiRelay.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="900">
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock Text="System" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="AccessStatusText" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Request notification access" Click="RequestAccessButton_Click" /><Button Content="Refresh" Click="RefreshButton_Click" /></StackPanel><ToggleSwitch x:Name="StartupToggle" Header="Start NotiRelay when I sign in" Toggled="StartupToggle_Toggled" /></StackPanel></Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Language" FontSize="20" FontWeight="SemiBold" /><ComboBox IsEnabled="False" SelectedIndex="0"><ComboBoxItem Content="System default (localization arrives in the next slice)" /></ComboBox></StackPanel></Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Privacy and data" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Secrets are stored in Windows Credential Locker. Terminal Delivery records do not retain notification content." TextWrapping="Wrap" /><Button Content="Clear completed Delivery metadata" HorizontalAlignment="Left" Click="ClearMetadataButton_Click" /></StackPanel></Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="About" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="NotiRelay 1.0.0" /><TextBlock Text="Windows 11 build 22621 or later · x64 supported" Opacity="0.7" /></StackPanel></Border>
        <InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" />
    </StackPanel></ScrollViewer>
</Page>
