<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NotiRelay.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiRelay.Controls">
    <controls:PageLayout MaxContentWidth="{StaticResource MaxContentWidth}">
        <controls:PageLayout.PageContent>
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <controls:PageHeader x:Uid="SettingsHeader" />

                <StackPanel Style="{StaticResource CardStackStyle}">
                    <Border Style="{StaticResource GroupCardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Uid="SettingsStartupSection" Padding="{StaticResource CardHeaderPadding}" Style="{StaticResource CardTitleTextBlockStyle}" />
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid MinHeight="{StaticResource RowHeightSetting}" Padding="{StaticResource CardRowPadding}" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingS}" SizeChanged="SettingRow_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource CardIconColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE7E8;" Style="{StaticResource SettingsRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock Text="{x:Bind StartupTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="StartupDescriptionText" Text="{x:Bind StartupDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" MinWidth="0" AutomationProperties.Name="{x:Bind StartupTitle}" OffContent="" OnContent="" Toggled="StartupToggle_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid MinHeight="{StaticResource RowHeightSetting}" Padding="{StaticResource CardRowPadding}" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingS}" SizeChanged="SettingRow_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource CardIconColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE708;" Style="{StaticResource SettingsRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock Text="{x:Bind SilentStartTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind SilentStartDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SilentStartToggle" Grid.Column="2" MinWidth="0" AutomationProperties.Name="{x:Bind SilentStartTitle}" OffContent="" OnContent="" Toggled="SilentStartToggle_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid MinHeight="{StaticResource RowHeightSetting}" Padding="{StaticResource CardRowPadding}" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingS}" SizeChanged="SettingRow_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource CardIconColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE770;" Style="{StaticResource SettingsRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock Text="{x:Bind CloseActionTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind CloseActionDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="CloseActionSelector" x:Uid="CloseActionSelector" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="CloseActionSelector_SelectionChanged" Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem x:Uid="CloseActionMinimize" />
                                    <ComboBoxItem x:Uid="CloseActionExit" />
                                    <ComboBoxItem x:Uid="CloseActionAsk" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Uid="SettingsSystemSection" Padding="{StaticResource CardHeaderPadding}" Style="{StaticResource CardTitleTextBlockStyle}" />
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid MinHeight="{StaticResource RowHeightSetting}" Padding="{StaticResource CardRowPadding}" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingS}" SizeChanged="SettingRow_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource CardIconColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE72E;" Style="{StaticResource SettingsRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock Text="{x:Bind NotificationAccessTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="NotificationAccessDescriptionText" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <Button x:Name="RequestAccessButton" x:Uid="RequestNotificationAccess" Grid.Column="2" VerticalAlignment="Center" Click="RequestAccessButton_Click" Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid MinHeight="{StaticResource RowHeightSetting}" Padding="{StaticResource CardRowPadding}" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingS}" SizeChanged="SettingRow_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource CardIconColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE774;" Style="{StaticResource SettingsRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock Text="{x:Bind LanguageTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="LanguageDescriptionText" Text="{x:Bind LanguageDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageSelector" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind LanguageTitle}" SelectionChanged="LanguageSelector_SelectionChanged" Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem x:Uid="LanguageSystem" Tag="" />
                                    <ComboBoxItem x:Uid="LanguageEnglish" Tag="en-US" />
                                    <ComboBoxItem x:Uid="LanguageChinese" Tag="zh-CN" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Uid="SettingsPrivacySection" Padding="{StaticResource CardHeaderPadding}" Style="{StaticResource CardTitleTextBlockStyle}" />
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid MinHeight="{StaticResource RowHeightSetting}" Padding="{StaticResource CardRowPadding}" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingS}" SizeChanged="SettingRow_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource CardIconColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE74D;" Style="{StaticResource SettingsRowIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock x:Uid="SettingsPrivacyActionTitle" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="PrivacyDescriptionText" Text="{x:Bind PrivacyDescription}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <Button x:Uid="ClearDeliveryMetadata" Grid.Column="2" VerticalAlignment="Center" Click="ClearMetadataButton_Click" Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </controls:PageLayout.PageContent>
    </controls:PageLayout>
</Page>
