<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NotiRelay.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiRelay.Controls"
    xmlns:models="using:NotiRelay.Models">
    <controls:PageLayout MaxContentWidth="{StaticResource MaxContentWidth}">
        <controls:PageLayout.PageContent>
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <controls:PageHeader x:Uid="ActivityHeader" />

                <Border VerticalAlignment="Top" Style="{StaticResource GroupCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="ActivityCommandRow"
                            MinHeight="{StaticResource RowHeightSetting}"
                            Padding="{StaticResource CardCommandRowPadding}"
                            ColumnSpacing="{StaticResource SpacingM}"
                            RowSpacing="{StaticResource SpacingS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel MinWidth="0" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                <TextBlock Text="{x:Bind ActivityCardTitle}" Style="{StaticResource CardTitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="ActivitySummaryText"
                                    MinHeight="{StaticResource InlineStatusSlotHeight}"
                                    AutomationProperties.LiveSetting="Polite"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Style="{StaticResource DescriptionTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshActivityButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="RefreshActivityButton_Click"
                                Style="{StaticResource SecondaryCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE72C;" />
                                    <TextBlock Text="{x:Bind RefreshActivityLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />

                        <Grid Grid.Row="2" MinHeight="{StaticResource EmptyStateViewportMinHeight}" MaxHeight="{StaticResource ListViewportMaxHeight}">
                            <ScrollViewer Margin="{StaticResource PageScrollbarSafeInset}" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                <ItemsRepeater x:Name="ActivityRepeater" ItemsSource="{x:Bind FilteredActivity}">
                                    <ItemsRepeater.Layout><StackLayout /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:DeliveryActivityItem">
                                            <Border MinHeight="{StaticResource RowHeightList}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{StaticResource RowDividerThickness}" Padding="{StaticResource CardListRowPadding}">
                                                <Grid x:Name="ActivityItemGrid" ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingXS}" SizeChanged="ActivityItemGrid_SizeChanged">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowTitleTextBlockStyle}">
                                                        <Run Text="{x:Bind SourceApplicationName}" /><Run Text=" → " /><Run Text="{x:Bind DestinationName}" />
                                                    </TextBlock>
                                                    <TextBlock x:Name="WideStatus" Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind StatusText}" Style="{StaticResource BodyTextBlockStyle}" />
                                                    <TextBlock x:Name="WideMetadata" Grid.Row="1" Style="{StaticResource DescriptionTextBlockStyle}">
                                                        <Run Text="{x:Bind EnqueuedAtText}" /><Run Text=" · " /><Run Text="{x:Bind AttemptText}" />
                                                    </TextBlock>
                                                    <TextBlock x:Name="NarrowMetadata" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource DescriptionTextBlockStyle}">
                                                        <Run Text="{x:Bind StatusText}" /><Run Text=" · " /><Run Text="{x:Bind EnqueuedAtText}" /><Run Text=" · " /><Run Text="{x:Bind AttemptText}" />
                                                    </TextBlock>
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.ColumnSpan="2"
                                                        AutomationProperties.HelpText="{x:Bind ErrorText}"
                                                        MaxLines="2"
                                                        Text="{x:Bind ErrorText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap"
                                                        ToolTipService.ToolTip="{x:Bind ErrorText}"
                                                        Style="{StaticResource ErrorDescriptionTextBlockStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <Border x:Name="ActivityEmptyState" Padding="{StaticResource CardContentPadding}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpacingS}">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Center" Glyph="&#xE81C;" />
                                    <TextBlock x:Name="ActivityEmptyTitle" x:Uid="ActivityEmptyTitle" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="ActivityEmptyDescription" x:Uid="ActivityEmptyDescription" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </controls:PageLayout.PageContent>
    </controls:PageLayout>
</Page>
