<Page
    x:Class="NotiRelay.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiRelay.Controls">
    <controls:PageLayout MaxContentWidth="1100">
        <controls:PageLayout.PageContent>
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <controls:PageHeader x:Uid="HomeHeader" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6"><TextBlock x:Uid="HomeStatusTitle" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Runtime.Status, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Uid="HomePauseRelay" Grid.Column="1" IsOn="{x:Bind Runtime.IsPaused, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Grid x:Name="HomeStatisticsGrid" ColumnSpacing="12" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ThirdStatisticsColumn" Width="*" />
                        <ColumnDefinition x:Name="FourthStatisticsColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="EnabledSourcesCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock x:Uid="HomeEnabledSources" Opacity="0.7" /><TextBlock Text="{x:Bind Runtime.EnabledSourceCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border x:Name="DestinationsCard" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock x:Uid="HomeDestinations" Opacity="0.7" /><TextBlock Text="{x:Bind Runtime.ConfiguredDestinationCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border x:Name="PendingCard" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock x:Uid="HomePending" Opacity="0.7" /><TextBlock Text="{x:Bind Runtime.PendingCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border x:Name="FailedCard" Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock x:Uid="HomeFailed" Opacity="0.7" /><TextBlock Text="{x:Bind Runtime.FailedCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel></Border>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="NarrowStatistics">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="ThirdStatisticsColumn.Width" Value="0" />
                                    <Setter Target="FourthStatisticsColumn.Width" Value="0" />
                                    <Setter Target="PendingCard.(Grid.Column)" Value="0" />
                                    <Setter Target="PendingCard.(Grid.Row)" Value="1" />
                                    <Setter Target="FailedCard.(Grid.Column)" Value="1" />
                                    <Setter Target="FailedCard.(Grid.Row)" Value="1" />
                                    <Setter Target="HomeStatisticsGrid.RowSpacing" Value="12" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideStatistics">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="HomeQuickActions" FontSize="18" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="RequestNotificationAccess" Click="RequestAccessButton_Click" /><Button x:Uid="RefreshNow" Click="RefreshButton_Click" /><Button x:Uid="GenerateTestNotification" Click="GenerateTestNotificationButton_Click" /></StackPanel></StackPanel></Border>
            </StackPanel>
        </controls:PageLayout.PageContent>
    </controls:PageLayout>
</Page>
