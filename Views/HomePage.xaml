<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NotiRelay.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiRelay.Controls"
    xmlns:models="using:NotiRelay.Models">
    <controls:PageLayout MaxContentWidth="{StaticResource MaxContentWidth}">
        <controls:PageLayout.PageContent>
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <controls:PageHeader x:Uid="HomeHeader" />

                <StackPanel Style="{StaticResource CardStackStyle}">
                    <Border Style="{StaticResource GroupCardBorderStyle}">
                        <StackPanel>
                            <Grid
                                x:Name="ForwardingRow"
                                MinHeight="{StaticResource RowHeightSetting}"
                                Padding="{StaticResource CardRowPadding}"
                                ColumnSpacing="{StaticResource SpacingL}"
                                RowSpacing="{StaticResource SpacingS}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource CardIconColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="{StaticResource StandardIconSize}"
                                    VerticalAlignment="Center"
                                    Glyph="&#xE895;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock Text="{x:Bind ForwardingTitle}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="ForwardingDescriptionText" Style="{StaticResource DescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ForwardingToggle"
                                    Grid.Column="2"
                                    MinWidth="0"
                                    AutomationProperties.Name="{x:Bind ForwardingTitle}"
                                    AutomationProperties.HelpText="{x:Bind Runtime.ForwardingStatusText, Mode=OneWay}"
                                    IsEnabled="{x:Bind Runtime.CanToggleForwarding, Mode=OneWay}"
                                    IsOn="{x:Bind Runtime.IsForwardingEnabled, Mode=OneWay}"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="ForwardingToggle_Toggled" />
                            </Grid>
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <TextBlock
                                x:Uid="HomeCountsTitle"
                                Padding="{StaticResource CardHeaderPadding}"
                                Style="{StaticResource CardTitleTextBlockStyle}" />
                            <Border Style="{StaticResource CardDividerStyle}" />
                            <Grid
                                x:Name="CountsGrid"
                                Padding="{StaticResource CardContentPadding}"
                                ColumnSpacing="{StaticResource SpacingL}"
                                RowSpacing="{StaticResource SpacingL}"
                                SizeChanged="CountsGrid_SizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CountColumn0" Width="*" />
                                    <ColumnDefinition x:Name="CountColumn1" Width="*" />
                                    <ColumnDefinition x:Name="CountColumn2" Width="*" />
                                    <ColumnDefinition x:Name="CountColumn3" Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="AppsCountPanel" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock x:Uid="HomeAppsCount" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <TextBlock x:Name="AppsCountText" Style="{StaticResource CardTitleTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="DestinationsCountPanel" Grid.Column="1" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock x:Uid="HomeDestinationsCount" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <TextBlock x:Name="DestinationsCountText" Style="{StaticResource CardTitleTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="PendingCountPanel" Grid.Column="2" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock x:Uid="HomePendingCount" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <TextBlock x:Name="PendingCountText" Style="{StaticResource CardTitleTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="FailedCountPanel" Grid.Column="3" Spacing="{StaticResource SpacingXS}">
                                    <TextBlock x:Uid="HomeFailedCount" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <TextBlock x:Name="FailedCountText" Style="{StaticResource CardTitleTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="{StaticResource CardHeaderPadding}" ColumnSpacing="{StaticResource SpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="HomeRecentTitle" VerticalAlignment="Center" Style="{StaticResource CardTitleTextBlockStyle}" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="ViewActivityButton_Click"
                                    Style="{StaticResource SecondaryCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE81C;" />
                                        <TextBlock Text="{x:Bind ViewActivityLabel}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />
                            <Grid Grid.Row="2">
                                <ItemsControl x:Name="RecentItemsControl" ItemsSource="{x:Bind RecentActivity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DeliveryActivityItem">
                                            <Border
                                                MinHeight="{StaticResource RowHeightList}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="{StaticResource RowDividerThickness}"
                                                Padding="{StaticResource CardListRowPadding}">
                                                <Grid ColumnSpacing="{StaticResource SpacingM}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                                        <TextBlock Style="{StaticResource RowTitleTextBlockStyle}">
                                                            <Run Text="{x:Bind SourceApplicationName}" />
                                                            <Run Text=" → " />
                                                            <Run Text="{x:Bind DestinationName}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{x:Bind EnqueuedAtText}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind StatusText}" Style="{StaticResource BodyTextBlockStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="RecentEmptyText"
                                    x:Uid="HomeRecentEmpty"
                                    Padding="{StaticResource CardContentPadding}"
                                    Style="{StaticResource DescriptionTextBlockStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </controls:PageLayout.PageContent>
    </controls:PageLayout>
</Page>
