<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NotiRelay.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiRelay.Controls"
    xmlns:models="using:NotiRelay.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <controls:PageLayout MaxContentWidth="{StaticResource MaxContentWidth}">
        <controls:PageLayout.PageContent>
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <controls:PageHeader x:Uid="SourcesHeader" />

                <Border VerticalAlignment="Top" Style="{StaticResource GroupCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="SourcesCommandRow"
                            MinHeight="{StaticResource RowHeightSetting}"
                            Padding="{StaticResource CardCommandRowPadding}"
                            ColumnSpacing="{StaticResource SpacingM}"
                            RowSpacing="{StaticResource SpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MinWidth="0" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                <TextBlock Text="{x:Bind SourcesCardTitle}" Style="{StaticResource CardTitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="SourcesSummaryText"
                                    MinHeight="{StaticResource InlineStatusSlotHeight}"
                                    AutomationProperties.LiveSetting="Polite"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Style="{StaticResource DescriptionTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshApplicationsButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="RefreshApplicationsButton_Click"
                                Style="{StaticResource SecondaryCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE72C;" />
                                    <TextBlock Text="{x:Bind RefreshApplicationsLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardDividerStyle}" />

                        <Grid
                            x:Name="SourcesFilterRow"
                            Grid.Row="2"
                            Padding="{StaticResource CardContentPadding}"
                            ColumnSpacing="{StaticResource SpacingM}"
                            RowSpacing="{StaticResource SpacingS}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="SearchBox" x:Uid="SourcesSearch" MinWidth="0" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                            <toolkit:Segmented x:Name="SourcesFilterSelector" Grid.Column="1" SelectedIndex="0">
                                <toolkit:SegmentedItem x:Uid="SourcesFilterAll" />
                                <toolkit:SegmentedItem x:Uid="SourcesFilterEnabled" />
                            </toolkit:Segmented>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource CardDividerStyle}" />

                        <Grid Grid.Row="4" MinHeight="{StaticResource EmptyStateViewportMinHeight}" MaxHeight="{StaticResource ListViewportMaxHeight}">
                            <ScrollViewer Margin="{StaticResource PageScrollbarSafeInset}" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                <ItemsRepeater x:Name="SourcesRepeater" ItemsSource="{x:Bind FilteredSources}">
                                    <ItemsRepeater.Layout><StackLayout /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:SourceApplication">
                                            <Border MinHeight="{StaticResource RowHeightList}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="{StaticResource RowDividerThickness}" Padding="{StaticResource CardListRowPadding}">
                                                <Grid ColumnSpacing="{StaticResource SpacingL}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource CardIconColumnWidth}" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource StandardIconSize}" VerticalAlignment="Center" Glyph="&#xECAA;" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpacingXS}">
                                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource RowTitleTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind ApplicationUserModelId}" Style="{StaticResource DescriptionTextBlockStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch x:Uid="SourceEnabled" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OffContent="" OnContent="" Tag="{x:Bind ApplicationUserModelId}" Toggled="SourceToggleSwitch_Toggled" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <Border x:Name="EmptyState" Padding="{StaticResource CardContentPadding}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpacingS}">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Center" Glyph="&#xECAA;" />
                                    <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource RowTitleTextBlockStyle}" />
                                    <TextBlock x:Name="EmptyStateDescription" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource DescriptionTextBlockStyle}" />
                                    <Button x:Name="EmptyStateDiscoverButton" x:Uid="SourcesRefresh" HorizontalAlignment="Center" Click="RefreshApplicationsButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </controls:PageLayout.PageContent>
    </controls:PageLayout>
</Page>
