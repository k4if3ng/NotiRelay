<Page x:Class="NotiRelay.Views.FiltersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="900">
        <StackPanel Spacing="4"><TextBlock x:Uid="FiltersTitle" FontSize="28" FontWeight="SemiBold" /><TextBlock x:Uid="FiltersSubtitle" TextWrapping="Wrap" Opacity="0.7" /></StackPanel>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="12"><TextBox x:Uid="FiltersInclude" x:Name="IncludeTextBox" TextChanged="FilterTextBox_TextChanged" /><TextBox x:Uid="FiltersExclude" x:Name="ExcludeTextBox" TextChanged="FilterTextBox_TextChanged" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="SaveFilters" Click="SaveButton_Click" /><Button x:Uid="ResetFilters" Click="ResetButton_Click" /></StackPanel><TextBlock x:Name="PreviewText" TextWrapping="Wrap" /></StackPanel></Border>
    </StackPanel></ScrollViewer>
</Page>
