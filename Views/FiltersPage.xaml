<Page x:Class="NotiRelay.Views.FiltersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="900">
        <StackPanel Spacing="4"><TextBlock Text="Global filters" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Exclude takes priority over include. Keywords are case-insensitive and separated by semicolons." TextWrapping="Wrap" Opacity="0.7" /></StackPanel>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><StackPanel Spacing="12"><TextBox x:Name="IncludeTextBox" Header="Include any (empty allows all)" TextChanged="FilterTextBox_TextChanged" /><TextBox x:Name="ExcludeTextBox" Header="Exclude any" TextChanged="FilterTextBox_TextChanged" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save filters" Click="SaveButton_Click" /><Button Content="Reset editor" Click="ResetButton_Click" /></StackPanel><TextBlock x:Name="PreviewText" TextWrapping="Wrap" /></StackPanel></Border>
    </StackPanel></ScrollViewer>
</Page>
