<UserControl
    x:Class="NotiRelay.Controls.PageLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="PageLayout_SizeChanged">
    <ScrollViewer x:Name="PageScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
        <Border
            x:Name="ContentRoot"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Padding="{StaticResource PagePaddingCompact}">
            <ContentPresenter
                x:Name="PageContentPresenter"
                MaxWidth="{x:Bind MaxContentWidth, Mode=OneWay}"
                Margin="{StaticResource PageScrollbarSafeInset}"
                HorizontalAlignment="Stretch"
                Content="{x:Bind PageContent, Mode=OneWay}" />
        </Border>
    </ScrollViewer>
</UserControl>
