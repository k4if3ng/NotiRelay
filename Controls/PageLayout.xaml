<UserControl
    x:Class="NotiRelay.Controls.PageLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="PageLayout_SizeChanged">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Border
            x:Name="ContentRoot"
            HorizontalAlignment="Left"
            Padding="20,16,20,24">
            <ContentPresenter Content="{x:Bind PageContent, Mode=OneWay}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Standard">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1008" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContentRoot.Padding" Value="32,24,32,32" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ScrollViewer>
</UserControl>
