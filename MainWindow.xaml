<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotiRelay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="NotiRelay">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid
        x:Name="ShellRoot"
        Loaded="ShellRoot_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarRowHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <MenuFlyout x:Key="NotificationAreaContextMenu">
                <MenuFlyoutItem x:Uid="TrayShow" Command="{x:Bind ShowMainWindowCommand}" />
                <ToggleMenuFlyoutItem
                    x:Name="TrayForwardingStatusItem"
                    Click="TrayForwardingStatusItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="TrayExit" Command="{x:Bind ExitApplicationCommand}" />
            </MenuFlyout>
        </Grid.Resources>

        <tb:TaskbarIcon
            x:Name="NotificationAreaIcon"
            Grid.Row="1"
            Width="0"
            Height="0"
            ContextFlyout="{StaticResource NotificationAreaContextMenu}"
            CustomName="NotiRelay"
            IconSource="/Assets/NotiRelay.ico"
            LeftClickCommand="{x:Bind ShowMainWindowCommand}"
            NoLeftClickDelay="True"
            ToolTipText="NotiRelay" />

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{StaticResource TitleBarHeight}"
            SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCaptionInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightCaptionInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TitleBarBrandPanel"
                Grid.Column="1"
                Margin="{StaticResource TitleBarBrandMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource SpacingS}">
                <Image
                    Width="{StaticResource BrandMarkSize}"
                    Height="{StaticResource BrandMarkSize}"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Brand/NotiRelay.svg" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="NotiRelay" />
            </StackPanel>
            <Button
                x:Name="TitleBarPaneToggleButton"
                Grid.Column="2"
                Width="{StaticResource TitleBarInteractiveSize}"
                Height="{StaticResource TitleBarInteractiveSize}"
                Margin="{StaticResource TitleBarToggleMargin}"
                Click="TitleBarPaneToggleButton_Click"
                Loaded="TitleBarPaneToggleButton_Loaded"
                SizeChanged="TitleBarPaneToggleButton_SizeChanged"
                Style="{StaticResource TitleBarIconButtonStyle}">
                <FontIcon FontSize="{StaticResource NavigationGlyphSize}" Glyph="&#xE700;" />
            </Button>
        </Grid>

        <NavigationView
            x:Name="NavigationShell"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactPaneLength="{StaticResource NavPaneCompactWidth}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="{StaticResource NavPaneExpandedWidth}"
            ItemInvoked="NavigationShell_ItemInvoked"
            PaneClosed="NavigationShell_PaneClosed"
            PaneOpened="NavigationShell_PaneOpened"
            PaneDisplayMode="Left">
            <NavigationView.Resources>
                <SolidColorBrush
                    x:Key="NavigationViewContentBackground"
                    Color="{ThemeResource LayerFillColorDefault}" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem" x:Uid="NavHome" Tag="home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="SourcesNavigationItem" x:Uid="NavSources" Tag="sources"><NavigationViewItem.Icon><FontIcon Glyph="&#xECAA;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="DestinationsNavigationItem" x:Uid="NavDestinations" Tag="destinations"><NavigationViewItem.Icon><FontIcon Glyph="&#xE724;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="FiltersNavigationItem" x:Uid="NavFilters" Tag="filters"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="ActivityNavigationItem" x:Uid="NavActivity" Tag="activity"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="ForwardingStatusNavigationItem"
                    SelectsOnInvoked="False"
                    Tag="forwarding-status">
                    <NavigationViewItem.Icon><FontIcon x:Name="ForwardingStatusIcon" Glyph="&#xE895;" /></NavigationViewItem.Icon>
                    <TextBlock
                        x:Name="ForwardingFooterText"
                        VerticalAlignment="Center" />
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
			<Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
