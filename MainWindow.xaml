<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotiRelay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NotiRelay">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

		<Grid
			x:Name="RootGrid"
			Margin="24"
			RowSpacing="16"
			Loaded="RootGrid_Loaded">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			VerticalAlignment="Center"
			Spacing="12">

			<TextBlock
				Text="NotiRelay"
				FontSize="28"
				FontWeight="SemiBold" />

			<TextBlock
				x:Name="StatusText"
				VerticalAlignment="Center"
				Text="Checking notification access..." />

			<Button
				x:Name="RequestAccessButton"
				Content="Request notification access"
				Click="RequestAccessButton_Click" />

			<Button
				x:Name="RefreshNotificationsButton"
				Content="Refresh notifications"
				IsEnabled="False"
				Click="RefreshNotificationsButton_Click" />
		</StackPanel>

		<ListView
			Grid.Row="1"
			ItemsSource="{x:Bind CapturedNotifications}">
			<ListView.ItemTemplate>
				<DataTemplate>
					<StackPanel Padding="12" Spacing="4">
						<TextBlock
							Text="{Binding SourceApplicationName}"
							FontSize="16"
							FontWeight="SemiBold" />
						<TextBlock
							Text="{Binding Title}"
							FontWeight="SemiBold"
							TextWrapping="Wrap" />
						<TextBlock
							Text="{Binding Body}"
							TextWrapping="Wrap" />
						<StackPanel Orientation="Horizontal" Spacing="12">
							<TextBlock
								Text="{Binding CreatedAt}"
								FontSize="12"
								Opacity="0.6" />
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock
									Text="Windows ID:"
									FontSize="12"
									Opacity="0.6" />
								<TextBlock
									Text="{Binding WindowsNotificationId}"
									FontSize="12"
									Opacity="0.6" />
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</Window>
