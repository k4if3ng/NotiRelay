<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotiRelay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:NotiRelay.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NotiRelay">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

		<Grid
			x:Name="RootGrid"
			Margin="24"
			RowSpacing="16"
			Loaded="RootGrid_Loaded">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			VerticalAlignment="Center"
			Spacing="12">

			<TextBlock
				Text="NotiRelay"
				FontSize="28"
				FontWeight="SemiBold" />

			<TextBlock
				x:Name="StatusText"
				VerticalAlignment="Center"
				Text="Checking notification access..." />

			<Button
				x:Name="RequestAccessButton"
				Content="Request notification access"
				Click="RequestAccessButton_Click" />

			<Button
				x:Name="RefreshNotificationsButton"
				Content="Refresh notifications"
				IsEnabled="False"
				Click="RefreshNotificationsButton_Click" />
		</StackPanel>

			<Grid Grid.Row="1" ColumnSpacing="16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="320" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border
					Grid.Column="0"
					Padding="16"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					CornerRadius="8">
					<Grid RowSpacing="12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<TextBlock
							Text="Source applications"
							FontSize="20"
							FontWeight="SemiBold" />

						<TextBlock
							x:Name="SourceApplicationsStatusText"
							Grid.Row="1"
							Text="Loading source applications..."
							TextWrapping="Wrap" />

						<ListView
							Grid.Row="2"
							ItemsSource="{x:Bind SourceApplications}">
							<ListView.ItemTemplate>
								<DataTemplate x:DataType="models:SourceApplication">
									<Grid Padding="4,8" ColumnSpacing="12">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>

										<StackPanel Spacing="2">
											<TextBlock
												Text="{x:Bind DisplayName, Mode=OneWay}"
												FontWeight="SemiBold"
												TextWrapping="Wrap" />
											<TextBlock
												Text="{x:Bind ApplicationUserModelId}"
												FontSize="11"
												Opacity="0.6"
												TextTrimming="CharacterEllipsis" />
										</StackPanel>

										<ToggleSwitch
											Grid.Column="1"
											AutomationProperties.Name="Enable source application"
											IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
											Toggled="SourceApplicationToggleSwitch_Toggled" />
									</Grid>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Grid>
				</Border>

				<Border
					Grid.Column="1"
					Padding="16"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					CornerRadius="8">
					<Grid RowSpacing="12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<TextBlock
							Text="Captured notifications"
							FontSize="20"
							FontWeight="SemiBold" />

						<ListView
							Grid.Row="1"
							ItemsSource="{x:Bind CapturedNotifications}">
							<ListView.ItemTemplate>
								<DataTemplate x:DataType="models:CapturedNotification">
									<StackPanel Padding="12" Spacing="4">
										<TextBlock
											Text="{x:Bind SourceApplicationName}"
											FontSize="16"
											FontWeight="SemiBold" />
										<TextBlock
											Text="{x:Bind Title}"
											FontWeight="SemiBold"
											TextWrapping="Wrap" />
										<TextBlock
											Text="{x:Bind Body}"
											TextWrapping="Wrap" />
										<StackPanel Orientation="Horizontal" Spacing="12">
											<TextBlock
												Text="{x:Bind CreatedAt}"
												FontSize="12"
												Opacity="0.6" />
											<StackPanel Orientation="Horizontal" Spacing="4">
												<TextBlock
													Text="Windows ID:"
													FontSize="12"
													Opacity="0.6" />
												<TextBlock
													Text="{x:Bind WindowsNotificationId}"
													FontSize="12"
													Opacity="0.6" />
											</StackPanel>
										</StackPanel>
									</StackPanel>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Window>
